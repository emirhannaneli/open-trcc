{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "open-trcc",
  "version": "0.1.6",
  "identifier": "com.emirman.open-trcc",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Thermalright Control Center - Open TRCC",
        "width": 1080,
        "height": 700,
        "minWidth": 780,
        "minHeight": 540,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-open-trcc.rules": "linux/70-open-trcc.rules"
        }
      },
      "rpm": {
        "files": {
          "/usr/lib/udev/rules.d/70-open-trcc.rules": "linux/70-open-trcc.rules"
        }
      }
    },
    "category": "Utility",
    "shortDescription": "Control Thermalright cooler displays",
    "publisher": "Emirhan Naneli"
  }
}
